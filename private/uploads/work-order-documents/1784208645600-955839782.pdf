    //get marksheet data for edit
    function get_marks_data($class_id, $section_id, $session, $term)
    {
        if ($term == 'final') {
            $term1 = 'term-1';
            $term2 = 'term-2';

            $markterm1 = marks::where('marks.class_id', $class_id)->where('marks.section_id', $section_id)->where('marks.session', $session)->where('marks.term', $term1)->orderBy('marks.total', 'desc')->get();
            $markterm2 = marks::where('marks.class_id', $class_id)->where('marks.section_id', $section_id)->where('marks.session', $session)->where('marks.term', $term2)->orderBy('marks.total', 'desc')->get();
            $markterm3 = marks::where('marks.class_id', $class_id)->where('marks.section_id', $section_id)->where('marks.session', $session)->where('marks.term', $term)->orderBy('marks.total', 'desc')->get();
            $commonStudentIds = $markterm1->pluck('student_id')->intersect($markterm2->pluck('student_id'))->intersect($markterm3->pluck('student_id'));

            // Filter the results to only include students with data in all three terms
            $markterm1 = $markterm1->whereIn('student_id', $commonStudentIds);
            $markterm2 = $markterm2->whereIn('student_id', $commonStudentIds);
            $markterm3 = $markterm3->whereIn('student_id', $commonStudentIds);

            // Rest of the code remains the same
            $subject = subject::where('class_id', $class_id)->where('subjects.is_deleted', 0)->get();

            if ($markterm1 && $markterm2 && $markterm3) {

                $result = [];
                foreach ($markterm1 as $mark1) {
                    $student_id = $mark1->student_id;
                    $term1_total = $mark1->total;
                    $student = Student::where('student_id', $student_id)->first();
                    $classs = Classes::where('class_id', $mark1->class_id)->first();
                    $section = Section::where('sec_id', $mark1->section_id)->first();
                    $student_name = $student->student_name;
                    $section_name = $section->section_name;
                    $class_name = $classs->class_name;



                    $dat1 = $markterm2->where('student_id', $student_id)->first();
                    $term2_total = $dat1->total;

                    $data2 = $markterm3->where('student_id', $student_id)->first();
                    $final_total = $data2->total;

                    $total_marks = $term1_total + $term2_total + $final_total;

                    // Group by student_id
                    $result[$student_id] = [
                        'student_id' => $student_id,
                        'total_marks' => $total_marks,
                        'subject' => $subject,
                        'student_name' => $student_name,
                        'class_name' => $class_name,
                        'section_name' => $section_name,
                        'roll_no' => $mark1->roll_no,
                        'attendance' => $mark1->attendance,
                    ];
                }

                // Sort by total marks in descending order
                uasort($result, function ($a, $b) {
                    return $b['total_marks'] <=> $a['total_marks'];
                });

                return response()->json(['success' => 'success', 'result' => $result,], 200);
                // $mark = $markterm1;
                // return response()->json(['success' => 'success', 'mark' => $mark, 'subject' => $subject], 200);
            }
        } else {
            $mark = marks::where('marks.class_id', $class_id)->where('marks.section_id', $section_id)->where('marks.session', $session)->where('marks.term', $term)->orderBy('marks.total', 'desc')->get();
            $arr[] = '';
            foreach ($mark as $mark2) {
                $data = Student::where('student_id', $mark2->student_id)->first();
                $class = Classes::where('class_id', $mark2->class_id)->first();
                $section = Section::where('sec_id', $mark2->section_id)->first();
                $mark2->section = $section;
                $mark2->data = $data;
                $mark2->class = $class;
            }

            $subject = subject::where('class_id', $class_id)->where('subjects.is_deleted', 0)->get();
            return response()->json(['success' => 'success', 'mark' => $mark, 'subject' => $subject], 200);
        }


    }
    //get all marksheet data for with decoded data
    function get_all_marks_data($class_id, $section_id, $session, $term)
    {
        // $mark = marks::where('marks.class_id', $class_id)->where('marks.section_id', $section_id)->where('marks.session', $session)->where('marks.term', $term)->join('students', 'students.student_id', '=', 'marks.student_id')->join('class', 'class.class_id', '=', 'students.class_id')->join('sections', 'sections.sec_id', '=', 'students.section_id')->get();
        // $subject = subject::where('class_id', $class_id)->get();
        // $allMarkData = json_decode(json_encode($mark), true);

        // $mark->transform(function ($item) {
        //     $item->marks = json_decode($item->marks, true);
        //     return $item;
        // });
        // return response()->json(['success' => 'success', 'allMarkData' => $allMarkData, 'subject' => $subject, 'mark' => $mark], 200);

        $mark = marks::where('marks.class_id', $class_id)->where('marks.section_id', $section_id)->where('marks.session', $session)->where('marks.term', $term)
            // ->join('students', 'students.student_id', '=', 'marks.student_id')
            // ->join('class', 'class.class_id', '=', 'students.class_id')
            // ->join('sections', 'sections.sec_id', '=', 'students.section_id')
            ->orderBy('marks.total', 'desc')
            ->get();
        foreach ($mark as $st) {
            $classs = Classes::where('class_id', $st->class_id)->first();
            $section = Section::where('sec_id', $st->section_id)->first();
            $student = Student::where('student_id', $st->student_id)->first();
            $st->student_name = $student->student_name;
            $st->class_name = $classs->class_name;
            $st->section_name = $section->section_name;
            $st->father_name = $student->father_name;
            $st->dob = $student->dob;
            $st->registration_no = $student->registration_no;
            $st->roll_no = $student->roll_no;
        }
        $subject = subject::where('class_id', $class_id)->where('subjects.is_deleted', 0)->get();

        $allMarkData = json_decode(json_encode($mark), true);

        $mark->transform(function ($item) {

            $item->marks = json_decode($item->marks, true);
            $item->personal_dev = json_decode($item->personal_dev, true);
            $item->attendance = json_decode($item->attendance, true);

            // Decode personal_dev data
            return $item;
        });





        return response()->json(['success' => 'success', 'allMarkData' => $allMarkData, 'subject' => $subject, 'mark' => $mark], 200);
        // }
    }

    function save_data(Request $request)
    {
        $formData = $request->all(); // Get all form data

        $term = $formData['term'] ?? null;
        $session = $formData['session'] ?? null;
        $classId = $formData['class_id'] ?? null;
        $sectionId = $formData['section_id'] ?? null;

        // Remove general data to isolate student data
        $generalDataKeys = ['_token', 'term', 'session', 'class_id', 'section_id'];
        $studentData = array_diff_key($formData, array_flip($generalDataKeys));

        $studentsData = [];
        $subject = Subject::where('class_id', $classId)->where('subjects.is_deleted', 0)->get();
        $total_subject = 0;
        foreach ($subject as $sub) {
            if ($sub->subject_name == 'Attendance' || $sub->subject_name == 'ATTENDANCE' || $sub->subject_name == 'Attendance (No Marks)' || $sub->subject_name == 'ATTENDANCE (NO MARKS)' || $sub->subject_name == 'attendance') {

            } else {
                $total_subject += (int) $sub->total_mark;
            }

        }

        // Organize data by student IDs
        foreach ($studentData as $key => $value) {
            if (preg_match('/STUDENT(\d+)_/', $key, $matches)) {
                $studentId = 'STUDENT' . $matches[1];
                $subject = str_replace($studentId . '_', '', $key);

                // Initialize student data array if not already set
                if (!isset($studentsData[$studentId])) {
                    $studentsData[$studentId] = [
                        'marks' => [],
                        'additionalData' => [],
                        'attendances' => [],
                    ];
                }

                if ($subject == 'pol' || $subject == 'party' || $subject == 'work' || $subject == 'home' || $subject == 'punch' || $subject == 'test' || $subject == 'is_neet' || $subject == 'response') {

                    $studentsData[$studentId]['additionalData'][$subject] = trim($value);

                } else
                    if ($subject == 'attendance') {
                        $studentsData[$studentId]['attendances'][$subject] = trim($value);
                    } else {
                        // Add mark to student data
                        $studentsData[$studentId]['marks'][$subject] = trim($value);
                    }
            }
        }

        if ((!empty($studentsData))) {
            foreach ($studentsData as $studentId => $studentData) {
                $marks = $studentData['marks'] ?? [];
                $additionalData = $studentData['additionalData'] ?? [];
                $attendances = $studentData['attendances'] ?? [];
                $totalMarks = 0;
                $percentage = 0;
                foreach ($marks as $subject => $mark) {
                    if ($subject == 'Attendance' || $subject == 'ATTENDANCE' || $subject == 'Attendance (No Marks)' || $subject == 'ATTENDANCE (NO MARKS)' || $subject == 'attendance') {
                    } else {
                        $totalMarks += (int) $mark;
                    }
                }


                $percentage = $totalMarks / $total_subject * 100;
                $markDB = marks::where('marks.student_id', $studentId)->where('marks.term', $term)->first();

                if (!$markDB) {
                    marks::create([
                        'mark_id' => 'MARK' . rand(0000000, 999999),
                        'student_id' => $studentId,
                        'session' => $session,
                        'class_id' => $classId,
                        'section_id' => $sectionId,
                        'term' => $term,
                        'marks' => json_encode($marks),
                        'personal_dev' => json_encode($additionalData),
                        'total' => $totalMarks,
                        'percentage' => $percentage,
                        'attendance' => json_encode($attendances),
                    ]);
                } else {
                    // Update existing marks and additionalData arrays
                    $markDB->marks = json_encode($marks);
                    $markDB->personal_dev = json_encode($additionalData);
                    $markDB->attendance = json_encode($attendances);

                    $markDB->total = $totalMarks;
                    $markDB->percentage = $percentage;
                    $markDB->save();
                }
            }
        }

        return response()->json(['success' => 'Marks added successfully',], 200);
    }
    //get view final data for marksheet
    function get_view_marks_data($class_id, $section_id, $session, $term, $student_id)
    {
        if ($term == 'final') {
            $term1 = 'term-1';
            $term2 = 'term-2';

            $mark1 = marks::where('marks.class_id', $class_id)
                ->where('marks.section_id', $section_id)
                ->where('marks.session', $session)
                ->where('marks.term', $term1)
                ->where('students.student_id', $student_id)
                ->join('students', 'students.student_id', '=', 'marks.student_id')
                ->join('class', 'class.class_id', '=', 'students.class_id')
                ->join('sections', 'sections.sec_id', '=', 'students.section_id')
                ->select('marks.*', 'students.*', 'class.*', 'sections.*')

                ->first();

            $subject = subject::where('class_id', $class_id)->where('subjects.is_deleted', 0)->get();



            $allMarkData1 = json_decode(json_encode($mark1), true);
            $allMarkData1['attendance'] = json_decode($allMarkData1['attendance'], true);

            $mark1->marks = json_decode($mark1->marks, true);

            $mark1->personal_dev = json_decode($mark1->personal_dev, true);

            $mark2 = marks::where('marks.class_id', $class_id)
                ->where('marks.section_id', $section_id)
                ->where('marks.session', $session)
                ->where('marks.term', $term2)
                ->join('students', 'students.student_id', '=', 'marks.student_id')
                ->join('class', 'class.class_id', '=', 'students.class_id')
                ->join('sections', 'sections.sec_id', '=', 'students.section_id')
                ->where('students.student_id', $student_id)
                ->first();





            $allMarkData2 = json_decode(json_encode($mark2), true);


            $mark2->marks = json_decode($mark2->marks, true);
            $mark2->personal_dev = json_decode($mark2->personal_dev, true);
            $mark3 = marks::where('marks.class_id', $class_id)
                ->where('marks.section_id', $section_id)
                ->where('marks.session', $session)
                ->where('marks.term', $term)
                ->join('students', 'students.student_id', '=', 'marks.student_id')
                ->join('class', 'class.class_id', '=', 'students.class_id')
                ->join('sections', 'sections.sec_id', '=', 'students.section_id')
                ->where('students.student_id', $student_id)
                ->first();
            $subject = subject::where('class_id', $class_id)->where('subjects.is_deleted', 0)->get();




            $allMarkData3 = json_decode(json_encode($mark3), true);
            // $mark3['attendance'] = json_decode($allMarkData3['attendance'], true); 
            $mark3->attendance = json_decode($allMarkData3['attendance'], true);


            $mark3->marks = json_decode($mark3->marks, true);
            $mark3->personal_dev = json_decode($mark3->personal_dev, true);

            if ($mark1 && $mark2 && $mark3) {

                return response()->json(['success' => 'success', 'allMarkData1' => $allMarkData1, 'allMarkData2' => $allMarkData2, 'allMarkData3' => $allMarkData3, 'subject' => $subject, 'mark1' => $mark1, 'mark2' => $mark2, 'mark3' => $mark3], 200);
            }
            return response()->json(['success' => 'success', 'allMarkData1' => $allMarkData1, 'allMarkData2' => $allMarkData2, 'allMarkData3' => $allMarkData3, 'subject' => $subject, 'mark1' => $mark1, 'mark2' => $mark2, 'mark3' => $mark3], 200);

        } else {
            $mark = marks::where('marks.class_id', $class_id)
                ->where('marks.section_id', $section_id)
                ->where('marks.session', $session)
                ->where('marks.term', $term)
                ->join('students', 'students.student_id', '=', 'marks.student_id')
                ->join('class', 'class.class_id', '=', 'students.class_id')
                ->join('sections', 'sections.sec_id', '=', 'students.section_id')
                ->where('students.student_id', $student_id)
                ->first();

            $allMarkData = json_decode(json_encode($mark), true);
            $allMarkData['attendance'] = json_decode($allMarkData['attendance'], true);



            $mark->marks = json_decode($mark->marks, true);
            $mark->personal_dev = json_decode($mark->personal_dev, true);

            $subject = subject::where('class_id', $class_id)->where('subjects.is_deleted', 0)->get();

            return response()->json(['success' => 'success', 'mark' => $mark, 'subject' => $subject, 'allMarkData' => $allMarkData], 200);
        }
    }

