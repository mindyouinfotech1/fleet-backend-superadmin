    //Show class
    function Class()
    {
        $class = Classes::where('is_active', 1)->where('is_deleted', 0)->get();
        return view('Admin.class', compact('class'));
    }
    function AddClass(Request $request)
    {
        $request->validate([
            'name' => 'required|string|max:255',
            'numeric_name' => 'required',

        ]);
        try {
            $class = new Classes;
            $class->class_id = 'CLASS' . rand('100000', '999999');
            $class->class_name = ucfirst($request->name);
            $class->numeric_name = $request->numeric_name;

            $class->save();
            return redirect()->back()->with('success', 'Class added successfully');
        } catch (\Exception $e) {
            return redirect()->back()->with('error', 'Class not added ' . $e->getMessage());
        }
    }


    // Delete Class
    function DeleteClass($id)
    {
        try {
            $class = Classes::where('class_id', $id)->first();
            $class->is_deleted = 1;
            $class->save();
            return redirect()->back()->with('success', 'Class deleted successfully');
        } catch (\Exception $e) {
            return redirect()->back()->with('error', 'Class not deleted ' . $e->getMessage());
        }
    }

    // Update Class
    function UpdateClass(Request $request)
    {
        $request->validate([
            'class_id' => 'required',
            'name' => 'required|string|max:255',
            'numeric_name' => 'required',

        ]);
        try {
            $class = Classes::where('class_id', $request->class_id)->first();
            if ($class) {
                $class->class_name = ucfirst($request->name);
                $class->numeric_name = $request->numeric_name;

                $class->save();
                return redirect()->back()->with('success', 'Class updated successfully');

            }
            return redirect()->back()->with('error', 'Class not Found');
        } catch (\Exception $e) {
            return redirect()->back()->with('error', 'Class not updated ' . $e->getMessage());
        }
    }

    // Start Teacher Section
//Show Teacher
    function Teacher()
    {
        $teacher = teacher::where('is_active', 1)->where('is_deleted', 0)->get();
        return view('Admin.teachers', compact('teacher'));


    }
    //Add Teacher
    function AddTeacher(Request $request)
    {
        $request->validate([
            'teacher_name' => 'required|string|max:255',
            'dob' => 'required',
            'age' => 'required',
            'mobile' => 'required',
            'email' => 'required|email',
            'address' => 'required|string',
            'city' => 'required|string',
            'country' => 'required|string',
            'register_date' => 'required',
            'job_type' => 'required|string',
            'photo' => 'nullable|file|mimes:jpeg,png,jpg',
        ]);
        $teacher = new teacher;
        $teacher->teacher_id = 'TEACHER' . rand('100000', '999999');
        $teacher->teacher_name = $request->teacher_name;
        $teacher->dob = $request->dob;
        $teacher->age = $request->age;
        $teacher->mobile = $request->mobile;
        $teacher->email = $request->email;
        $teacher->address = $request->address;
        $teacher->city = $request->city;
        $teacher->country = $request->country;
        $teacher->reg_date = $request->register_date;
        $teacher->job_type = $request->job_type;
        if ($request->hasFile('photo')) {
            $image = $request->file('photo');
            $imagePath = 'teacher_img/' . time() . '.' . $image->getClientOriginalExtension();
            $image->move(public_path('teacher_img'), $imagePath);
            $teacher->profile_image = $imagePath;
        }
        $teacher->save();
        return redirect()->back()->with('success', 'Teacher added successfully');


    }

    //Edit Teacher

    function UpdateTeacher(Request $request)
    {
        $request->validate([
            'teacher_id' => 'required',
            'teacher_name' => 'required|string|max:255',
            'dob' => 'required',
            'age' => 'required',
            'mobile' => 'required',
            'email' => 'required|email',
            'address' => 'required|string',
            'city' => 'required|string',
            'country' => 'required|string',
            'register_date' => 'required',
            'job_type' => 'required|string',
            'photo' => 'nullable|file|mimes:jpeg,png,jpg',
        ]);
        $teacher = teacher::where('teacher_id', $request->teacher_id)->first();
        if ($teacher) {
            $teacher->teacher_name = $request->teacher_name;
            $teacher->dob = $request->dob;
            $teacher->age = $request->age;
            $teacher->mobile = $request->mobile;
            $teacher->email = $request->email;
            $teacher->address = $request->address;
            $teacher->city = $request->city;
            $teacher->country = $request->country;
            $teacher->reg_date = $request->register_date;
            $teacher->job_type = $request->job_type;
            if ($request->hasFile('photo')) {
                $image = $request->file('photo');
                $imagePath = 'teacher_img/' . time() . '.' . $image->getClientOriginalExtension();
                $image->move(public_path('teacher_img'), $imagePath);
                $teacher->profile_image = $imagePath;
            }
            $teacher->save();
            return redirect()->back()->with('success', 'Teacher Updated successfully');

        }
    }

    // Delete Teacher

    function DeleteTeacher($id)
    {
        try {
            $teacher = teacher::where('teacher_id', $id)->first();
            if ($teacher) {
                $teacher->is_deleted = 1;
                $teacher->save();
                return redirect()->back()->with('success', 'Teacher deleted successfully');
            }
        } catch (\Exception $e) {
            return redirect()->back()->with('error', 'Teacher not deleted ' . $e->getMessage());
        }

    }


    //get section data by class id
    function get_section($class_id)
    {
        $section = section::where('class_id', $class_id)->where('sections.is_deleted', 0)->where('sections.is_active', 1)->join('teachers', 'sections.teacher_id', '=', 'teachers.teacher_id')
            ->select('sections.section_name', 'teachers.teacher_name', 'sections.sec_id as section_id', 'sections.teacher_id', 'sections.class_id')->

            get();
        if ($section) {
            return response()->json(['success' => 'success', 'section' => $section], 200);
        }
        return response()->json(['error' => 'error'], 500);

    }

    //add section
    function add_section(Request $request)
    {

        $request->validate([
            'class_id' => 'required',
            'section_name' => 'required|string|max:255',
            'teacher_id' => 'required',
        ]);
        $section = new section();
        $section->sec_id = 'SECTION' . rand('100000', '999999');
        $section->class_id = $request->class_id;
        $section->section_name = ucwords($request->section_name);
        $section->teacher_id = $request->teacher_id;
        $section->save();
        return redirect()->back()->with('success', 'Section added successfully');
    }

    //update section
    function UpdateSection(Request $request)
    {
        $request->validate([
            'class_id' => 'required',
            'section_name' => 'required|string|max:255',
            'teacher_id' => 'required',
            'section_id' => 'required',
        ]);
        $section = section::where('sec_id', $request->section_id)->first();
        if ($section) {
            $section->class_id = $request->class_id;
            $section->section_name = ucwords($request->section_name);
            $section->teacher_id = $request->teacher_id;
            $section->save();
            return redirect()->back()->with('success', 'Section updated successfully');
        }
        return redirect()->back()->with('error', 'Section not Found');
    }
    //delete section
    function DeleteSection($id)
    {
        $section = section::where('sec_id', $id)->first();
        if ($section) {
            $section->is_deleted = 1;
            $section->save();
            return redirect()->back()->with('success', 'Section deleted successfully');
        }
        return redirect()->back()->with('error', 'Section not Found');
    }

    //get subject
    function get_subject($class_id)
    {
        $subject = subject::where('class_id', $class_id)->where('subjects.is_deleted', 0)->where('subjects.is_active', 1)->join('teachers', 'subjects.teacher_id', '=', 'teachers.teacher_id')
            ->select('subjects.*', 'teachers.teacher_name')
            ->get();
        if ($subject) {
            return response()->json(['success' => 'success', 'subject' => $subject], 200);
        }
        return response()->json(['error' => 'not found'], 400);

    }
    //add subject

    function AddSubject(Request $request)
    {
        $request->validate([
            'class_id' => 'required',
            'subject_name' => 'required|string|max:255',
            'teacher_id' => 'required',
            'total_marks' => 'required|numeric',
            'min_marks' => 'required|numeric',

        ]);
        $subject = new subject();
        $subject->sub_id = 'SUBJECT' . rand('100000', '999999');
        $subject->subject_name = ucwords($request->subject_name);
        $subject->teacher_id = $request->teacher_id;
        $subject->total_mark = $request->total_marks;
        $subject->min_marks = $request->min_marks;
        $subject->class_id = $request->class_id;
        $subject->save();
        return redirect()->back()->with('success', 'Subject added successfully');

    }
    //update subject
    function updateSubject(Request $request)
    {

        $subject = subject::where('sub_id', $request->subject_id)->first();
        if ($subject) {
            $subject->subject_name = ucwords($request->subject_name);
            $subject->teacher_id = $request->teacher_id;
            $subject->total_mark = $request->total_marks;
            $subject->min_marks = $request->min_marks;
            $subject->class_id = $request->class_id;
            $subject->save();
            return redirect()->back()->with('success', 'Subject updated successfully');
        }
        return redirect()->back()->with('error', 'Subject not Found');

    }
    //delete subject
    function DeleteSubject($id)
    {

        $subject = subject::where('sub_id', $id)->first();
        if ($subject) {
            $subject->is_deleted = 1;
            $subject->save();
            return redirect()->back()->with('success', 'Subject deleted successfully');
        }
        return redirect()->back()->with('error', 'Subject not Found');
    }
    //get student session page
    function get_student_session_page()
    {
        $student_session = student_session::where('is_active', 1)->where('is_deleted', 0)->get();
        return view('Admin.session', compact('student_session'));
    }

    //add student session
    function AddSession(Request $request)
    {
        $request->validate([
            'start' => 'required|date',
            'end' => 'required|date',
        ]);
        try {
            $student_session = new student_session();
            $student_session->session_id = 'SESSION' . rand('100000', '999999');
            $student_session->start = $request->start;
            $student_session->end = $request->end;
            $student_session->save();
            return redirect()->back()->with('success', 'Session added successfully');
        } catch (\Exception $e) {
            return redirect()->back()->with('error', 'Session not added ' . $e->getMessage());
        }
    }


    //update student session
    function UpdateSession(Request $request)
    {
        $request->validate([
            'session_id' => 'required',
            'start' => 'required|date',
            'end' => 'required|date',
        ]);
        try {
            $student_session = student_session::where('session_id', $request->session_id)->first();
            if ($student_session) {
                $student_session->start = $request->start;
                $student_session->end = $request->end;
                $student_session->save();
                return redirect()->back()->with('success', 'Session updated successfully');
            }
            return redirect()->back()->with('error', 'Session not Found');
        } catch (\Exception $e) {
            return redirect()->back()->with('error', 'Session not updated ' . $e->getMessage());
        }
    }
    //delete student session
    function DeleteSession($id)
    {
        try {
            $student_session = student_session::where('session_id', $id)->first();
            if ($student_session) {
                $student_session->is_deleted = 1;
                $student_session->save();
                return redirect()->back()->with('success', 'Session deleted successfully');
            }
            return redirect()->back()->with('error', 'Session not Found');
        } catch (\Exception $e) {
            return redirect()->back()->with('error', 'Session not deleted ' . $e->getMessage());
        }
    }

