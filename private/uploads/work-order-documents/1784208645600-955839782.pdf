    //get student data by class id
    function get_student($class_id, $section_id)
    {


        $student = student::where('is_active', 1)->where('is_deleted', 0)->where('class_id', $class_id)->where('section_id', $section_id)->get();
        if ($student) {
            return response()->json(['success' => 'success', 'student' => $student], 200);
        } else {
            return response()->json(['error' => 'student not found'], 400);
        }
    }

    //add student
    function AddStudent(Request $request)
    {

        $request->validate([

            'student_name' => 'required|string|max:255',
            'father_name' => 'required|string|max:255',
            'mother_name' => 'required|string|max:255',

            'documents' => 'nullable|string|max:255',

            'class_id' => 'required|string|max:255',
            'section_id' => 'required|string|max:255',
            'dob' => 'required|string|max:255',
            'gender' => 'required|string|max:255',

            'religion' => 'required|string|max:255',
            'category' => 'required|string|max:255',
            'full_postal_address' => 'required|string|max:255',
            'mobile' => 'required|string|max:255',
            // 'full_per_address' => 'required|string|max:255',
            'st_addhar_no' => 'required|string|max:255',

            'previous_school' => 'nullable|string|max:255',

            'addmission_number' => 'required|string|max:255',
            'addmission_date' => 'required|string|max:255',
            'profile_image' => 'nullable',

            'option1' => 'required|string|max:255',
            'option2' => 'required|string|max:255',
            'optional_documents' => 'nullable|string|max:255',
            'option3' => 'required|string|max:255',
            'roll_no' => 'required',
            'registration_no' => 'required',
        ]);

        $student = new student();

        $student->student_id = 'STUDENT' . rand('100000', '999999');
        $student->student_name = $request->input('student_name');
        $student->father_name = $request->input('father_name');
        $student->mother_name = $request->input('mother_name');

        $student->documents = $request->input('documents');


        $student->class_id = $request->input('class_id');
        $student->section_id = $request->input('section_id');
        $student->dob = $request->input('dob');
        $student->gender = $request->input('gender');
        // $student->weight = $request->input('weight');
        // $student->height = $request->input('height');
        $student->religion = $request->input('religion');
        $student->category = $request->input('category');
        $student->full_postal_address = $request->input('full_postal_address');
        $student->mobile = $request->input('mobile');
        // $student->full_per_address = $request->input('full_per_address');
        // $student->mobile2 = $request->input('mobile2');
        // $student->area = $request->input('area');
        // $student->father_occu = $request->input('father_occu');
        // $student->mother_occu = $request->input('mother_occu');
        // $student->bpl_no = $request->input('bpl_no');
        $student->st_addhar_no = $request->input('st_addhar_no');
        // $student->parent_addhar_no = $request->input('parent_addhar_no');
        // $student->bank_ac_no = $request->input('bank_ac_no');
        // $student->ifsc = $request->input('ifsc');
        // $student->email = $request->input('email');
        $student->registration_no = $request->input('registration_no');
        $student->previous_school = $request->input('previous_school');
        // $student->gardian_full_name = $request->input('gardian_full_name');
        $student->addmission_number = $request->input('addmission_number');
        $student->addmission_date = $request->input('addmission_date');
        $student->session = $request->input('session');
        $student->adhar_prof = "yes";
        $student->age_prof = "yes";
        $student->photo = "yes";
        $student->roll_no = $request->input('roll_no');

        if ($request->hasFile('profile_image')) {
            $image = $request->file('profile_image');
            $imagePath = 'student_img/' . time() . '.' . $image->getClientOriginalExtension();
            $image->move(public_path('student_img/'), $imagePath);
            $student->profile_image = $imagePath;

        }


        $student->save();
        return redirect()->back()->with('success', 'Student added successfully');

    }
