    //Admin Login
    public function Admin_Login(Request $request)
    {
        try {
            $request->validate([
                'email' => 'required|email',
                'password' => 'required|string',
            ]);

            // Find the admin by admin_id
            $admin = Users::where('email', $request->email)->first();
            if ($admin) {

                if ($admin->password == $request->password) {
                    session(['user' => $admin->user_id]);
                    return redirect('/dashboard');
                } else {
                    return back()->with('error', ' Invalid Password');
                }
            } else {
                return back()->with('error', 'User name or password is incorrect');
            }
        } catch (\Exception $exception) {
            // Handle exceptions if needed
            return response()->json(['error' => $exception->getMessage()], 500);
        }
    }

    // Admin Logout
    public function AdminLogout()
    {
        if (session()->has('user')) {
            $user = session('user');

            session()->flush();
            session()->flash('success', 'Logout Successfully');

            return redirect('/');
        } else {
            session()->flash('error', 'You are not currently logout in as admin');
            return redirect('/');
        }
    }

    // Dasboard
    function Dasboard()
    {
        return view('Admin.index');
