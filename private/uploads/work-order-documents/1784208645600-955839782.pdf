    //get full marks data for marksheet print alll
    function get_full_marks_data($class_id, $section_id, $session, $term)
    {
        if ($term == 'final') {
            $term1 = 'term-1';
            $term2 = 'term-2';

            $mark1 = marks::where('marks.class_id', $class_id)
                ->where('marks.section_id', $section_id)
                ->where('marks.session', $session)
                ->where('marks.term', $term1)

                ->join('students', 'students.student_id', '=', 'marks.student_id')
                ->join('class', 'class.class_id', '=', 'students.class_id')
                ->join('sections', 'sections.sec_id', '=', 'students.section_id')
                ->select('marks.*', 'students.*', 'class.*', 'sections.*')

                ->get();

            $subject = subject::where('class_id', $class_id)->where('subjects.is_deleted', 0)->get();



            $mark1->transform(function ($item) {
                $item->marks = json_decode($item->marks, true);
                $item->personal_dev = json_decode($item->personal_dev, true);
                $item->attendance = json_decode($item->attendance, true);
                // Decode personal_dev data
                return $item;
            });
            // $allMarkData1 = json_decode(json_encode($mark1), true);

            // $mark1->marks = json_decode($mark1->marks, true);

            // $mark1->personal_dev = json_decode($mark1->personal_dev, true);

            $mark2 = marks::where('marks.class_id', $class_id)
                ->where('marks.section_id', $section_id)
                ->where('marks.session', $session)
                ->where('marks.term', $term2)
                ->join('students', 'students.student_id', '=', 'marks.student_id')
                ->join('class', 'class.class_id', '=', 'students.class_id')
                ->join('sections', 'sections.sec_id', '=', 'students.section_id')

                ->get();
            // $subject = subject::where('class_id', $class_id)->get();


            $mark2->transform(function ($item) {
                $item->marks = json_decode($item->marks, true);
                $item->personal_dev = json_decode($item->personal_dev, true);
                $item->attendance = json_decode($item->attendance, true);
                // Decode personal_dev data
                return $item;
            });

            // $allMarkData2 = json_decode(json_encode($mark2), true);


            // $mark2->marks = json_decode($mark2->marks, true);
            // $mark2->personal_dev = json_decode($mark2->personal_dev, true);
            $mark3 = marks::where('marks.class_id', $class_id)
                ->where('marks.section_id', $section_id)
                ->where('marks.session', $session)
                ->where('marks.term', $term)
                ->join('students', 'students.student_id', '=', 'marks.student_id')
                ->join('class', 'class.class_id', '=', 'students.class_id')
                ->join('sections', 'sections.sec_id', '=', 'students.section_id')

                ->get();
            // $subject = subject::where('class_id', $class_id)->get();



            $mark3->transform(function ($item) {
                $item->marks = json_decode($item->marks, true);
                $item->personal_dev = json_decode($item->personal_dev, true);
                $item->attendance = json_decode($item->attendance, true);
                // Decode personal_dev data
                return $item;
            });
            // $allMarkData3 = json_decode(json_encode($mark3), true);


            // $mark3->marks = json_decode($mark3->marks, true);
            // $mark3->personal_dev = json_decode($mark3->personal_dev, true);
            // $subject = subject::where('class_id', $class_id)->get();
            $commonStudentIds = $mark1->pluck('student_id')->intersect($mark2->pluck('student_id'))->intersect($mark3->pluck('student_id'));
            $mark1 = $mark1->filter(function ($item) use ($commonStudentIds) {
                return $commonStudentIds->contains($item->student_id);
            });

            $mark2 = $mark2->filter(function ($item) use ($commonStudentIds) {
                return $commonStudentIds->contains($item->student_id);
            });

            $mark3 = $mark3->filter(function ($item) use ($commonStudentIds) {
                return $commonStudentIds->contains($item->student_id);
            });

            $mergedMarks = $mark1->keyBy('student_id')->map(function ($item) use ($mark2, $mark3) {
                $term2 = $mark2->where('student_id', $item->student_id)->first();
                $term3 = $mark3->where('student_id', $item->student_id)->first();

                $item->mark1 = $item->marks;
                $item->personaldev1 = $item->personal_dev;
                $item->total1 = $item->total; // retrieve total from the database
                $item->percentage1 = $item->percentage; // retrieve percentage from the database

                $item->mark2 = $term2->marks;
                $item->personaldev2 = $term2->personal_dev;
                $item->total2 = $term2->total; // retrieve total from the database
                $item->percentage2 = $term2->percentage; // retrieve percentage from the database

                $item->mark3 = $term3->marks;
                $item->personaldev3 = $term3->personal_dev;
                $item->total3 = $term3->total; // retrieve total from the database
                $item->percentage3 = $term3->percentage;
                $item->attendance3 = $term3->attendance;

                // retrieve percentage from the database

                unset($item->marks);
                unset($item->personal_dev);
                unset($item->total); // unset the original total column
                unset($item->percentage); // unset the original percentage column

                return $item;
            });
            return response()->json(['success' => 'success', 'subject' => $subject, 'marks' => $mergedMarks, 'mark1' => $mark1], 200);
        }
    }
    /*---------------------------------Marksheet Module Ends Here -------------------------------*/


    /*---------------------------------Fee Module Starts Here -------------------------------*/
    //Show fee page
    function show_add_fee()
    {
        return view('Admin.add_fee_by_class');
    }
    //get fee data by class id
    function get_fee($class_id)
    {
        $fee = fee::where('is_active', 1)->where('is_deleted', 0)->where('class_id', $class_id)->get();
        return response()->json(['success' => 'success', 'fee' => $fee], 200);
    }
    // add fee by class
    function AddFee(Request $request)
    {
        $request->validate([
            'class_id' => 'required',
            'fee_name' => 'required|string|max:255',
            'fee_amount' => 'required|numeric',

        ]);
        try {
            $fee = new fee;
            $fee->fee_id = 'FEE' . rand('100000', '999999');
            $fee->class_id = $request->class_id;
            $fee->fee_name = trim(ucwords($request->fee_name));
            $fee->fee_amount = trim($request->fee_amount);

            $fee->save();
            return redirect()->back()->with('success', 'Fee added successfully');
        } catch (\Exception $e) {
            return redirect()->back()->with('error', 'Fee not added ' . $e->getMessage());
        }
    }
    //update fee
    function UpdateFee(Request $request)
    {
        $request->validate([
            'fee_id' => 'required',
            'class_id' => 'required',
            'fee_name' => 'required|string|max:255',
            'fee_amount' => 'required|numeric',

        ]);

        $fee = fee::where('fee_id', $request->fee_id)->first();
        if ($fee) {
            $fee->class_id = $request->class_id;
            $fee->fee_name = trim(ucwords($request->fee_name));
            $fee->fee_amount = trim($request->fee_amount);

            $fee->save();
            return redirect()->back()->with('success', 'Fee updated successfully');
        }
        return redirect()->back()->with('error', 'Fee not Found');
    }
    //delete fee 
    function DeleteFee($id)
    {
        try {
            $fee = fee::where('fee_id', $id)->first();
            if ($fee) {
                $fee->is_deleted = 1;
                $fee->save();
                return redirect()->back()->with('success', 'Fee deleted successfully');
            }
            return redirect()->back()->with('error', 'Fee not Found');
        } catch (\Exception $e) {
            return redirect()->back()->with('error', 'Fee not found ' . $e->getMessage());
        }

    }
    //collect fee
    function collect_fee()
    {
        return view('Admin.collect-fee');
    }
    //get Student Detail for collect fee
    function get_student_detail_collect_fee($class_id, $section_id, $student_id)
    {
        $student = student::where('students.is_active', 1)->where('students.is_deleted', 0)->where('students.class_id', $class_id)->where('students.section_id', $section_id)->where('students.student_id', $student_id)->join('class', 'class.class_id', '=', 'students.class_id')->join('sections', 'sections.sec_id', '=', 'students.section_id')->first();
        return response()->json(['success' => 'success', 'student' => $student], 200);
    }
    function get_collect_fee_details($class_id)
    {
        $fee = fee::where('fee.is_active', 1)->where('fee.is_deleted', 0)->where('fee.class_id', $class_id)->get();
        if ($fee->count()) {
            return response()->json(['success' => 'success', 'fee' => $fee], 200);

        }
        return response()->json(['error' => 'fee not found'], 400);
    }





















    //get data for admit card
    function get_data_for_admit_card($class_id, $section_id, $session)
    {
        $student = student::where('students.is_active', 1)->where('students.is_deleted', 0)->where('students.class_id', $class_id)->where('students.section_id', $section_id)->where('students.session', $session)->join('class', 'class.class_id', '=', 'students.class_id')->join('sections', 'sections.sec_id', '=', 'students.section_id')->get();
        return response()->json(['success' => 'success', 'student' => $student], 200);
    }








































